{
  "id": "navidrome",
  "name": "Navidrome",
  "version": "1.2.0",
  "minAppVersion": "0.1.20",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": ["*"],
    "process": [
      "bin/navidrome-login-*",
      "ffmpeg",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg",
      "/opt/local/bin/ffmpeg"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Albums",
      "page": "albums:alphabeticalByName:0",
      "icon": "album"
    },
    {
      "title": "Artists",
      "page": "artists",
      "icon": "artist"
    },
    {
      "builtin": "liked",
      "title": "Liked"
    },
    {
      "builtin": "savedAlbums",
      "title": "Starred"
    },
    {
      "builtin": "stations",
      "title": "Radio"
    }
  ]
}
